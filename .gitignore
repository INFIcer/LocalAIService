# ---------------------------------------------------------------------------
# Python / 构建产物
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# 虚拟环境（与机器绑定，体积大，不随仓库分发）
# ---------------------------------------------------------------------------
.venv/
engine/.venv/
svc/.venv/
env/
venv/

# ---------------------------------------------------------------------------
# 数据目录（模型 / 音色 / 输出 / 日志 / 声纹库 / 临时）
#   - models/ 约 9GB，且每个模型有自己的 license
#   - voices/ 与 *.wav/*.mp3 是声音素材，可能含个人声音
#   - speakers/ 是声纹库（个人生物特征）
#   - outputs/ logs/ 是运行产物，可能含用户文本
# ---------------------------------------------------------------------------
models/
voices/
outputs/
logs/
speakers/
out/

# 任务队列数据（SQLite 任务库 + 异步任务上传文件；运行产物，绝不入库）
data/

# 声音 / 视频素材（防止从别的目录误加进来）
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.m4a
*.aac
*.mp4
*.mkv
*.mov
*.webm
*.avi

# ---------------------------------------------------------------------------
# 配置与密钥（本仓库不保存任何 token/密码）
# ---------------------------------------------------------------------------
.env
.env.*
*.local
secrets.json
config.json
*.token
bili_credential.json

# ---------------------------------------------------------------------------
# 运行时临时文件
# ---------------------------------------------------------------------------
*.log
*.tmp
*.part
*.bak
.DS_Store
Thumbs.db
